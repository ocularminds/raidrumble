# Local judge mode needs no credentials. Copy this file to .env for live setup.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_USER_ID=
# Optional exact registered callback; defaults to PUBLIC_BASE_URL/auth/callback.
TWITCH_AUTH_URL=
PUBLIC_BASE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=
POLICY_GATE=local
DECIONIS_API_BASE=https://api.decionis.com
DECIONIS_ORG_ID=
DECIONIS_API_KEY=
DECIONIS_ENFORCE_API_KEY=
DECIONIS_MODE=SHADOW
# Optional separately onboarded proxy; never used as the authority API base.
DECIONIS_GATEWAY_URL=
# Restrict local development to this interface. Configure authentication before exposing it.
HOST=127.0.0.1
PORT=3000
LEDGER_PATH=data/raidrumble.sqlite3
